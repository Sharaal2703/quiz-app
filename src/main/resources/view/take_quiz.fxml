<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizapp.controller.TakeQuizController">
  <content>
    <VBox prefHeight="580.0" prefWidth="780.0" spacing="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" spacing="20.0" style="-fx-background-color: #f0f0f0;">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label fx:id="titleLabel" text="Quiz Title">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="descriptionLabel" text="Quiz Description" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox spacing="5.0">
                     <children>
                        <Label fx:id="timeLimitLabel" text="Time Limit: 30 minutes" />
                        <Label fx:id="timerLabel" text="Time Remaining: 30:00">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="450.0" prefWidth="780.0" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="questionsContainer" prefHeight="440.0" prefWidth="760.0" spacing="20.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
            <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
               <children>
                  <Button fx:id="submitButton" mnemonicParsing="false" onAction="#handleSubmitAction" text="Submit Quiz" />
               </children>
            </HBox>
         </children>
      </VBox>
  </content>
</ScrollPane>