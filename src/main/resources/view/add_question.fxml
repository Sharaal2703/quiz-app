<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizapp.controller.AddQuestionController">
  <content>
    <VBox alignment="CENTER" prefHeight="480.0" prefWidth="580.0" spacing="20.0">
         <children>
            <Text text="Add Question" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Text>
            <VBox spacing="10.0">
               <children>
                  <Label text="Question Type:" />
                  <HBox spacing="20.0">
                     <children>
                        <RadioButton fx:id="multipleChoiceRadio" mnemonicParsing="false" selected="true" text="Multiple Choice">
                           <toggleGroup>
                              <ToggleGroup fx:id="questionTypeGroup" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="trueFalseRadio" mnemonicParsing="false" text="True/False" toggleGroup="$questionTypeGroup" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="10.0">
               <children>
                  <Label text="Question:" />
                  <TextArea fx:id="questionTextArea" prefHeight="100.0" prefWidth="500.0" />
               </children>
            </VBox>
            <VBox spacing="10.0">
               <children>
                  <Label text="Options:" />
                  <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" />
                    </rowConstraints>
                     <children>
                        <Label text="Option 1:" />
                        <Label text="Option 2:" GridPane.rowIndex="1" />
                        <Label text="Option 3:" GridPane.rowIndex="2" />
                        <Label text="Option 4:" GridPane.rowIndex="3" />
                        <TextField fx:id="option1Field" GridPane.columnIndex="1" />
                        <TextField fx:id="option2Field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="option3Field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="option4Field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <RadioButton fx:id="option1Radio" mnemonicParsing="false" GridPane.columnIndex="2">
                           <toggleGroup>
                              <ToggleGroup fx:id="correctOptionGroup" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="option2Radio" mnemonicParsing="false" GridPane.columnIndex="2" GridPane.rowIndex="1" toggleGroup="$correctOptionGroup" />
                        <RadioButton fx:id="option3Radio" mnemonicParsing="false" GridPane.columnIndex="2" GridPane.rowIndex="2" toggleGroup="$correctOptionGroup" />
                        <RadioButton fx:id="option4Radio" mnemonicParsing="false" GridPane.columnIndex="2" GridPane.rowIndex="3" toggleGroup="$correctOptionGroup" />
                        <Label text="Correct:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveAction" text="Save" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancelAction" text="Cancel" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
  </content>
</ScrollPane>