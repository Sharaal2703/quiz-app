<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizapp.controller.EditQuizController">
   <children>
      <Text text="Edit Quiz" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Text>
      <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints halignment="RIGHT" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints minWidth="10.0" prefWidth="400.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" />
        </rowConstraints>
         <children>
            <Label text="Title:" />
            <Label text="Description:" GridPane.rowIndex="1" />
            <Label text="Time Limit (minutes):" GridPane.rowIndex="2" />
            <TextField fx:id="titleField" GridPane.columnIndex="1" />
            <TextArea fx:id="descriptionArea" prefHeight="100.0" prefWidth="400.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="timeLimitField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <HBox alignment="CENTER" spacing="20.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveAction" text="Save" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancelAction" text="Cancel" />
                  <Button fx:id="addQuestionButton" mnemonicParsing="false" onAction="#handleAddQuestionAction" text="Add Question" />
               </children>
            </HBox>
         </children>
      </GridPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>