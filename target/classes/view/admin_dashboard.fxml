<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizapp.controller.AdminController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" spacing="20.0" style="-fx-background-color: #f0f0f0;">
         <children>
            <Text text="Admin Dashboard">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Text>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogoutAction" text="Logout" />
         </children>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Button fx:id="createQuizButton" mnemonicParsing="false" onAction="#handleCreateQuizAction" text="Create Quiz" />
            <Button fx:id="editQuizButton" mnemonicParsing="false" onAction="#handleEditQuizAction" text="Edit Quiz" />
            <Button fx:id="deleteQuizButton" mnemonicParsing="false" onAction="#handleDeleteQuizAction" text="Delete Quiz" />
         </children>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
      </HBox>
      <TableView fx:id="quizTable" prefHeight="500.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="titleColumn" prefWidth="200.0" text="Title" />
          <TableColumn fx:id="descriptionColumn" prefWidth="300.0" text="Description" />
          <TableColumn fx:id="timeLimitColumn" prefWidth="100.0" text="Time Limit (min)" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>